---
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import V from '../../components/V.astro';
import Cta from '../../components/Cta.astro';
import { work, moreWork } from '../../data/work';
---
<Base title="Work · PixelMetrics" description="Software, websites and automation we built and still run. Listed by running since, not by launch date.">
  <div class="wrap">
    <header class="intro">
      <div class="lead">
        <span class="eyebrow">Work · Listed by running since</span>
        <h1 class="display">Still <em>running</em><span class="stop" aria-hidden="true"></span></h1>
      </div>
      <p class="body">Each project shows the business, the work and the one number it changed. We list it by how long it has been live, because the brand is only as good as what’s still running.</p>
    </header>

    <ol class="list">
      {work.map((p, i) => (
        <li>
          <a href={`/work/${p.slug}/`} class="row">
            {p.images?.[0]
              ? <Shot src={p.images[0].src} alt={p.images[0].alt} widths={[400, 800]} sizes="(max-width: 960px) 40vw, 280px" cover class="thumb" />
              : <span class="thumb thumb--empty todo">Image placeholder</span>}
            <span class="n sec-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="main">
              <span class="eyebrow">{p.relation}</span>
              <span class="client">{p.client}</span>
              <span class="headline"><V v={p.headline} /></span>
            </span>
            <dl class="facts">
              <div><dt>Built</dt><dd><V v={p.built} /></dd></div>
              <div><dt>Running since</dt><dd class="metric"><V v={p.runningSince} /></dd></div>
              <div><dt>Result</dt><dd><V v={p.result} /></dd></div>
            </dl>
          </a>
        </li>
      ))}
    </ol>

    <section class="more" aria-labelledby="more-h">
      <h2 id="more-h" class="eyebrow">More client work</h2>
      <ul>
        {moreWork.map((m) => (
          <li>
            <span class="more-client">{m.client}</span>
            <span class="more-meta">{m.kind} · {m.place}</span>
            <p><V v={m.d} /></p>
            {typeof m.url === 'string'
              ? <a href={m.url} rel="noopener">Visit site ↗</a>
              : <span class="todo link">Visit site ↗ (link needed)</span>}
          </li>
        ))}
      </ul>
    </section>
  </div>

  <div class="wrap-wide cta-wrap"><Cta /></div>
</Base>

<style>
  .intro {
    padding: clamp(32px, 4vw, 56px) 0 clamp(28px, 3vw, 40px);
    display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-end; justify-content: space-between;
  }
  .lead { flex: 1 1 520px; display: flex; flex-direction: column; gap: 16px; }
  h1 { font-size: clamp(56px, 7vw, 104px); line-height: .9; }
  .intro .body { flex: 0 1 380px; }

  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .list li { border-bottom: 1px solid var(--line); }
  .row {
    display: grid; grid-template-columns: 280px 40px minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 24px; align-items: start; padding: 24px 0; color: var(--bone);
  }
  .row:hover { color: var(--bone); }
  .row:hover .client { color: var(--lime); }
  .row :global(.thumb) { width: 100%; aspect-ratio: 16 / 10; border: 1px solid var(--line); }
  .thumb--empty { display: flex; align-items: center; justify-content: center; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); }
  .main { display: flex; flex-direction: column; gap: 10px; }
  .client { font-family: var(--serif); font-size: clamp(32px, 3.6vw, 48px); font-weight: 300; letter-spacing: -.03em; line-height: 1; }
  .headline { font-size: 15px; line-height: 1.55; color: var(--muted); max-width: 44ch; }
  .facts { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-left: 1px solid var(--line); }
  .facts > div { padding: 0 14px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; }
  .facts > div:last-child { border-right: 0; }
  dt { font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); }
  dd { margin: 0; font-size: 14px; line-height: 1.4; }

  @media (max-width: 960px) {
    .row { grid-template-columns: minmax(0, 1fr); }
    .n { display: none; }
    .facts { grid-column: 1 / -1; border-left: 0; border-top: 1px solid var(--line); padding-top: 14px; }
    .facts > div:first-child { padding-left: 0; }
  }

  .more { padding: 56px 0 0; display: flex; flex-direction: column; gap: 20px; }
  .more ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px 40px; }
  .more li { border-top: 1px solid var(--line-quiet); padding-top: 14px; display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
  .more-client { font-family: var(--serif); font-size: 26px; font-weight: 300; letter-spacing: -.02em; line-height: 1.05; }
  .more-meta { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--graphite); }
  .more p { font-size: 14px; line-height: 1.55; color: var(--muted); max-width: 52ch; }
  .more a, .more .link { font-size: 14px; margin-top: 4px; }

  .cta-wrap { padding-top: 88px; padding-bottom: 120px; }
</style>
