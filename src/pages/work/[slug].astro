---
// Case study as a zoom: open on the whole business, resolve to the one pixel it changed.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Field from '../../components/Field.astro';
import Section from '../../components/Section.astro';
import V from '../../components/V.astro';
import Cta from '../../components/Cta.astro';
import { work, text, type Project } from '../../data/work';

export function getStaticPaths() {
  return work.map((p, i) => ({ params: { slug: p.slug }, props: { p, next: work[(i + 1) % work.length] } }));
}

interface Props { p: Project; next: Project }
const { p, next } = Astro.props;

const zoom = [
  { cap: '1 · the business', min: '400', maxd: undefined },
  { cap: '4 · its functions', min: '0.5', maxd: '1' },
  { cap: '16 · its workflows', min: '0.5', maxd: '2' },
  { cap: '1px · the drain we fixed, now running', min: '0.5', maxd: '5', lit: true },
];
---
<Base title={`${p.client} · Work · PixelMetrics`} description={text(p.headline)}>
  <div class="wrap">
    <header class="intro">
      <nav class="crumbs eyebrow" aria-label="Breadcrumb"><a href="/work/">Work</a> / <span>{p.client}</span></nav>
      <div class="intro-row">
        <div class="lead">
          <span class="eyebrow">{p.relation}</span>
          <h1 class="display">{p.client}</h1>
          <p class="voice"><V v={p.headline} /></p>
        </div>
        <div class="side">
          <p class="body"><V v={p.lede} /></p>
          {p.url && <a class="btn" href={p.url} rel="noopener">Visit {new URL(p.url).host} ↗</a>}
        </div>
      </div>
    </header>

    <section class="zoom" aria-label="Zoom from the whole business to the one pixel we changed">
      {zoom.map((z) => (
        <figure data-resolve>
          <Field min={z.min} maxd={z.maxd} k="0.01" fx={p.focus.x} fy={p.focus.y} nolit={!z.lit} class="qt--sq" />
          <figcaption class:list={{ lit: z.lit }}>{z.cap}</figcaption>
        </figure>
      ))}
    </section>

    <section class="pixel" aria-label="The one pixel it changed" data-resolve>
      <span class="eyebrow"><V v={p.pixel.label} /></span>
      <span class="pixel-value metric"><V v={p.pixel.value} /><span class="beat" aria-hidden="true"></span></span>
      <dl class="facts">
        <div><dt>Client</dt><dd>{p.client}</dd></div>
        <div><dt>Built</dt><dd><V v={p.built} /></dd></div>
        <div><dt>Running since</dt><dd class="metric"><V v={p.runningSince} /></dd></div>
        <div><dt>Result</dt><dd><V v={p.result} /></dd></div>
      </dl>
    </section>

    {p.images?.length ? (
      <div class="shots">
        {p.images.map((im, i) => (
          <figure class:list={['shot-frame', { lead: i === 0 }]} data-resolve>
            <Image src={im.src} alt={im.alt} widths={[640, 1000, 1400, 2000]} sizes={i === 0 ? '(max-width: 1320px) 100vw, 1208px' : '(max-width: 760px) 100vw, 50vw'} />
          </figure>
        ))}
      </div>
    ) : (
      <div class="image" data-resolve>
        <Field min="0.5" maxd="7" k="1.3" fx={p.focus.x} fy={p.focus.y} nolit class="qt--bare" style="position:absolute;inset:0;height:100%" />
        <span class="todo slot">Case study image placeholder · 16:9</span>
      </div>
    )}

    {p.chapters.map((c, i) => (
      <Section n={String(i + 1).padStart(2, '0')} title={c.t}>
        <p class="voice chapter"><V v={c.d} /></p>
        {c.points && (
          <ul class="points">
            {c.points.map((pt) => <li><V v={pt} /></li>)}
          </ul>
        )}
      </Section>
    ))}

    <a href={`/work/${next.slug}/`} class="next">
      <span class="eyebrow">Next project</span>
      <span class="next-client">{next.client} →</span>
    </a>
  </div>

  <div class="wrap-wide cta-wrap"><Cta /></div>
</Base>

<style>
  .intro { padding: clamp(40px, 6vw, 88px) 0 clamp(32px, 5vw, 64px); display: flex; flex-direction: column; gap: 40px; }
  .crumbs a { color: var(--graphite); }
  .crumbs a:hover { color: var(--lime); }
  .crumbs span { color: var(--bone); }
  .intro-row { display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-end; justify-content: space-between; }
  .lead { flex: 1 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  h1 { font-size: clamp(48px, 7.4vw, 120px); line-height: .9; overflow-wrap: anywhere; }
  .lead .voice { font-size: clamp(22px, 2.4vw, 32px); max-width: 28ch; }
  .side { flex: 0 1 380px; display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }

  .zoom { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; padding-bottom: 56px; }
  .zoom figure { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .zoom figcaption { font-size: 12px; color: var(--graphite); }
  .zoom figcaption.lit { color: var(--lime); }

  .pixel { border-top: 1px solid var(--line-strong); padding: 28px 0 56px; display: flex; flex-direction: column; gap: 12px; }
  .pixel-value { font-size: clamp(72px, 12vw, 176px); line-height: .9; letter-spacing: -.04em; display: flex; align-items: flex-start; gap: .12em; }
  .pixel-value .beat { width: .08em; height: .08em; margin-top: .1em; }
  .facts { margin: 32px 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--line); background: var(--ink); }
  .facts > div { padding: 12px 14px 18px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .facts > div:last-child { border-right: 0; }
  dt { font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); }
  dd { margin: 0; font-size: 15px; line-height: 1.4; }
  @media (max-width: 640px) {
    .facts { grid-template-columns: 1fr 1fr; }
    .facts > div:nth-child(2) { border-right: 0; }
    .facts > div:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
  }

  .image { position: relative; aspect-ratio: 16 / 9; border: 1px solid var(--line); background: var(--ink); margin-bottom: 72px; overflow: hidden; }
  .slot { position: absolute; left: 18px; bottom: 16px; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); padding: 2px 4px; }

  .shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-bottom: 72px; }
  .shot-frame { margin: 0; border: 1px solid var(--line); background: var(--ink); overflow: hidden; }
  .shot-frame.lead { grid-column: 1 / -1; }
  .shot-frame img { display: block; width: 100%; height: auto; }
  .chapter { font-size: clamp(22px, 2.2vw, 30px); max-width: 34ch; }
  .points {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px 40px;
  }
  .points li { border-top: 1px solid var(--line-quiet); padding-top: 12px; font-size: 15px; line-height: 1.55; color: var(--muted); text-wrap: pretty; }

  .next { display: flex; flex-direction: column; gap: 12px; border-top: 1px solid var(--line-strong); padding: 28px 0 0; }
  .next-client { font-family: var(--serif); font-size: clamp(40px, 6vw, 88px); font-weight: 300; letter-spacing: -.04em; line-height: 1; }

  .cta-wrap { padding-top: 88px; padding-bottom: 120px; }
</style>
