---
// Case study: the project, the one number it changed and the work, on the first screen.
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import V from '../../components/V.astro';
import Cta from '../../components/Cta.astro';
import Quote from '../../components/Quote.astro';
import { work, text, type Project } from '../../data/work';

export function getStaticPaths() {
  return work.map((p, i) => ({ params: { slug: p.slug }, props: { p, next: work[(i + 1) % work.length] } }));
}

interface Props { p: Project; next: Project }
const { p, next } = Astro.props;
const [lead, ...rest] = p.images ?? [];
---
<Base title={`${p.client} · Work · PixelMetrics`} description={text(p.headline)}>
  <div class="wrap">
    <header class="top">
      <div class="lead">
        <nav class="crumbs eyebrow" aria-label="Breadcrumb"><a href="/work/">Work</a> / <span>{p.client}</span></nav>
        <span class="eyebrow">{p.relation}</span>
        <h1 class="display">{p.client}</h1>
        <p class="voice"><V v={p.headline} /></p>
        <div class="pixel">
          <span class="pixel-value metric"><V v={p.pixel.value} /></span>
          <span class="pixel-label"><V v={p.pixel.label} /></span>
        </div>
        {p.url && <a class="btn" href={p.url} rel="noopener">Visit {new URL(p.url).host} ↗</a>}
      </div>
      <div class="lead-shot">
        {lead
          ? <Shot src={lead.src} alt={lead.alt} widths={[640, 1000, 1400, 2000]} sizes="(max-width: 960px) 100vw, 60vw" eager />
          : <span class="todo slot">Case study image placeholder · 16:9</span>}
      </div>
    </header>

    <dl class="facts">
      <div><dt>Client</dt><dd>{p.client}</dd></div>
      <div><dt>Built</dt><dd><V v={p.built} /></dd></div>
      <div><dt>Live since</dt><dd class="metric"><V v={p.runningSince} /></dd></div>
      <div><dt>Result</dt><dd><V v={p.result} /></dd></div>
    </dl>

    <section class="ba" aria-label="Before and after">
      <div class="ba-cell"><span class="eyebrow">Before</span><p>{p.before}</p></div>
      <div class="ba-cell after"><span class="eyebrow">After</span><p>{p.after}</p></div>
    </section>

    <ul class="results" aria-label="Results">
      {p.results.map((r) => <li>{r}</li>)}
    </ul>

    {p.quote && <div class="quote-wrap"><Quote {...p.quote} /></div>}

    {rest.length > 0 && (
      <div class:list={['gallery', { 'with-phone': rest.some((im) => im.phone) }]}>
        {rest.map((im) => (
          <Shot
            src={im.src}
            alt={im.alt}
            widths={im.phone ? [400, 800] : [640, 1000, 1400]}
            sizes={im.phone ? '(max-width: 760px) 80vw, 400px' : '(max-width: 760px) 100vw, 800px'}
            cover={im.phone}
            class={im.phone ? 'frame phone' : 'frame'}
          />
        ))}
      </div>
    )}


    <a href={`/work/${next.slug}/`} class="next">
      <span class="eyebrow">Next project</span>
      <span class="next-client">{next.client} →</span>
    </a>
  </div>

  <div class="wrap-wide cta-wrap"><Cta /></div>
</Base>

<style>
  .top {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); gap: 32px clamp(24px, 3vw, 48px);
    align-items: center; padding: clamp(24px, 3vw, 40px) 0 24px;
  }
  .lead { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; min-width: 0; }
  .crumbs { margin-bottom: 6px; }
  .crumbs a { color: var(--graphite); }
  .crumbs a:hover { color: var(--lime); }
  .crumbs span { color: var(--bone); }
  h1 { font-size: clamp(44px, 5vw, 80px); line-height: .92; overflow-wrap: anywhere; }
  .lead .voice { font-size: clamp(20px, 1.8vw, 26px); max-width: 30ch; }
  .pixel { display: flex; align-items: baseline; gap: 14px; padding: 14px 0 6px; border-top: 1px solid var(--line); align-self: stretch; }
  .pixel-value { font-size: clamp(48px, 5vw, 76px); line-height: .9; letter-spacing: -.04em; }
  .pixel-label { font-size: 14px; line-height: 1.35; color: var(--muted); max-width: 22ch; }
  .lead-shot { min-width: 0; }
  .lead-shot :global(.shot) { border: 1px solid var(--line); }
  .slot { display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 9; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); border: 1px solid var(--line); }
  @media (max-width: 960px) {
    .top { grid-template-columns: 1fr; }
  }

  .facts { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--line); background: var(--ink); }
  .facts > div { padding: 12px 14px 16px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .facts > div:last-child { border-right: 0; }
  dt { font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); }
  dd { margin: 0; font-size: 15px; line-height: 1.4; }
  @media (max-width: 640px) {
    .facts { grid-template-columns: 1fr 1fr; }
    .facts > div:nth-child(2) { border-right: 0; }
    .facts > div:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
  }

  .ba { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 40px 0 24px; }
  .ba-cell { border: 1px solid var(--line); background: var(--ink); padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .ba-cell p { font-family: var(--serif); font-weight: 300; font-size: clamp(20px, 1.9vw, 25px); line-height: 1.25; letter-spacing: -.01em; color: var(--soft); text-wrap: pretty; }
  .ba-cell.after { border-color: rgba(200, 238, 74, .45); }
  .ba-cell.after .eyebrow { color: var(--lime); }
  .ba-cell.after p { color: var(--bone); }
  .results { list-style: none; margin: 0 0 48px; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px 24px; }
  .results li { border-top: 1px solid var(--line-strong); padding-top: 12px; font-size: 16px; line-height: 1.45; }
  @media (max-width: 760px) { .ba { grid-template-columns: 1fr; } }
  .quote-wrap { margin: 0 0 56px; }

  .gallery { display: grid; grid-template-columns: 1fr; gap: 16px; margin-bottom: 72px; }
  .gallery :global(.frame) { border: 1px solid var(--line); }
  .gallery.with-phone { grid-template-columns: 2fr 1fr; }
  .gallery.with-phone :global(.phone) { grid-column: 2; grid-row: 1 / span 2; }
  @media (max-width: 760px) {
    .gallery.with-phone { grid-template-columns: 1fr; }
    .gallery.with-phone :global(.phone) { grid-column: auto; grid-row: auto; width: 100%; max-width: 360px; aspect-ratio: 923 / 2000; justify-self: center; }
  }

  .next { display: flex; flex-direction: column; gap: 12px; border-top: 1px solid var(--line-strong); padding: 28px 0 0; }
  .next-client { font-family: var(--serif); font-size: clamp(40px, 6vw, 88px); font-weight: 300; letter-spacing: -.04em; line-height: 1; }

  .cta-wrap { padding-top: 88px; padding-bottom: 120px; }
</style>
