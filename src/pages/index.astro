---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Shot from '../components/Shot.astro';
import WorkCard from '../components/WorkCard.astro';
import Cta from '../components/Cta.astro';
import Quote from '../components/Quote.astro';
import V from '../components/V.astro';
import { BOOK_URL, offers, afterBooking, reasons, faqs, proof, industries, team } from '../data/site';
import { work } from '../data/work';
const featured = work.find((p) => p.slug === 'bird-of-paradise')!;
const quoted = work.find((p) => p.quote);
---
<Base>
  <!-- Hero: a plain promise, with the work and the results on the same screen. -->
  <div class="wrap-wide hero-wrap">
    <section class="hero" aria-labelledby="hero-h">
      <div class="hero-copy">
        <span class="eyebrow">Websites · Software · Automation</span>
        <h1 id="hero-h" class="display">Websites and software that bring in customers and <em>save your team hours.</em></h1>
        <p class="body">Designed, built in weeks and looked after by a small team in St. Petersburg, Florida.</p>
        <div class="actions">
          <a class="btn btn--solid" href={BOOK_URL}>Book a 30-min call</a>
          <a class="btn" href="/work/">See our work</a>
        </div>
      </div>
      <a class="hero-work" href={`/work/${featured.slug}/`}>
        <Shot src={featured.images![0].src} alt={featured.images![0].alt} widths={[640, 1000, 1400]} sizes="(max-width: 940px) 100vw, 55vw" eager />
        <span class="hero-caption"><span class="eyebrow">Featured · {featured.relation}</span><span>{featured.client} →</span></span>
      </a>
      <ul class="proof" aria-label="Results from our work">
        {proof.map((r) => (
          <li><a href={`/work/${r.slug}/`}>
            <span class="proof-value metric">{r.value}</span>
            <span class="proof-label">{r.label}</span>
            <span class="eyebrow">{r.client}</span>
          </a></li>
        ))}
      </ul>
    </section>
  </div>

  <div class="wrap">
    <Section id="services" n="01" title="What we build" note="Three things, often together in one project.">
      <ul class="offers">
        {offers.map((o) => (
          <li>
            <h3>{o.t}</h3>
            <p>{o.d}</p>
            <a href={`/work/${o.example.slug}/`}>See {o.example.label} →</a>
          </li>
        ))}
      </ul>
      <p class="who"><span class="eyebrow">Who we help</span> {industries.join(' · ')}</p>
    </Section>

    <Section id="method" n="02" title="What happens after you book">
      <ol class="steps">
        {afterBooking.map((s) => (
          <li>
            <span class="when"><V v={s.when} /></span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </Section>

    <Section id="work" n="03" title="Recent work" note="What we built, and what changed.">
      <div class="work-grid">
        {work.map((p) => <WorkCard p={p} />)}
      </div>
      {quoted?.quote && <Quote {...quoted.quote} href={`/work/${quoted.slug}/`} />}
      <a href="/work/" class="more">All work →</a>
    </Section>

    <Section n="04" title="Why us">
      <ul class="reasons">
        {reasons.map((r) => (
          <li>
            <h3>{r.t}</h3>
            <p>{r.d}</p>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="about" n="05" title="Small team. Serious software." note="The people you talk to on the first call are the people who build it.">
      <ul class="team">
        {team.map((m) => (
          <li>
            <span class="photo todo" aria-hidden="true">Photo</span>
            <span class="name">{m.name}</span>
            <span class="role"><V v={m.role} /></span>
            <p><V v={m.bio} /></p>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="questions" n="06" title="Questions">
      <div class="faqs">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p><V v={f.a} /></p>
          </details>
        ))}
      </div>
    </Section>
  </div>

  <div class="wrap-wide cta-wrap">
    <Cta />
  </div>
</Base>

<style>
  .hero-wrap { padding-top: var(--wide-gutter); padding-bottom: 72px; }
  .hero {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    background: var(--ink); border: 1px solid var(--line);
  }
  .hero-copy {
    padding: clamp(28px, 3.4vw, 48px) clamp(20px, 3vw, 36px);
    display: flex; flex-direction: column; justify-content: center; gap: 24px;
    border-right: 1px solid var(--line);
  }
  .hero h1 { font-size: clamp(40px, 4.6vw, 72px); line-height: .96; }
  .hero-copy .body { font-size: 17px; max-width: 44ch; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 4px; }
  .hero-work { display: flex; flex-direction: column; justify-content: center; gap: 12px; padding: clamp(16px, 2.4vw, 32px); color: var(--bone); }
  .hero-work :global(.shot) { border: 1px solid var(--line); }
  .hero-caption { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; font-size: 14px; }
  .hero-work:hover .hero-caption > :last-child { color: var(--lime); }
  .proof { grid-column: 1 / -1; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .proof li + li { border-left: 1px solid var(--line); }
  .proof a { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 16px; row-gap: 4px; align-items: baseline; padding: 16px clamp(20px, 3vw, 36px); color: var(--bone); }
  .proof a:hover .proof-value { color: var(--lime); }
  .proof-value { grid-row: 1 / 3; font-size: clamp(32px, 3.4vw, 48px); line-height: 1; letter-spacing: -.03em; }
  .proof-label { font-size: 14px; line-height: 1.35; }
  @media (max-width: 940px) {
    .hero { grid-template-columns: 1fr; }
    .hero-copy { border-right: 0; border-bottom: 1px solid var(--line); }
    .proof { grid-template-columns: 1fr; }
    .proof li + li { border-left: 0; border-top: 1px solid var(--line); }
  }

  /* Shared three-up lists: offers, steps, reasons */
  .offers, .steps, .reasons { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px 24px; }
  .offers li, .steps li, .reasons li { display: flex; flex-direction: column; gap: 8px; border-top: 1px solid var(--line-strong); padding-top: 16px; align-items: flex-start; }
  .offers h3, .steps h3, .reasons h3 { font-family: var(--serif); font-size: clamp(24px, 2.2vw, 30px); font-weight: 300; letter-spacing: -.02em; line-height: 1.05; }
  .offers p, .steps p, .reasons p { font-size: 15px; line-height: 1.55; color: var(--muted); text-wrap: pretty; max-width: 40ch; }
  .offers a { font-size: 14px; margin-top: 4px; border-bottom: 1px solid var(--line-strong); padding-bottom: 2px; }
  .when { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--lime); }

  .who { font-size: 14px; line-height: 1.6; color: var(--muted); }
  .who .eyebrow { margin-right: 10px; }

  /* Work */
  .work-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; }
  .more { font-size: 14px; align-self: flex-start; border-bottom: 1px solid var(--line-strong); padding-bottom: 2px; }

  /* Team */
  .team { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px 16px; }
  .team li { display: flex; flex-direction: column; gap: 6px; }
  .photo { aspect-ratio: 4 / 5; background: var(--ink); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); margin-bottom: 10px; }
  .name { font-family: var(--serif); font-size: 26px; font-weight: 300; letter-spacing: -.02em; line-height: 1.05; }
  .role { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--graphite); }
  .team p { font-size: 14px; line-height: 1.55; color: var(--muted); text-wrap: pretty; }

  /* Questions */
  .faqs { display: flex; flex-direction: column; border-top: 1px solid var(--line-strong); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; padding: 16px 0; font-family: var(--serif); font-size: clamp(20px, 1.8vw, 24px); font-weight: 300; letter-spacing: -.01em; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-family: var(--sans); color: var(--graphite); }
  details[open] summary::after { content: '−'; }
  summary:hover { color: var(--lime); }
  details p { padding: 0 0 18px; font-size: 15px; line-height: 1.6; color: var(--muted); max-width: 62ch; }

  .cta-wrap { padding-top: 16px; padding-bottom: 96px; }
</style>
