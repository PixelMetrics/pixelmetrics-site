---
// A case study as a resolution grid: the screenshot, then the facts.
import Shot from './Shot.astro';
import V from './V.astro';
import type { Project } from '../data/work';
interface Props { p: Project }
const { p } = Astro.props;
const lead = p.images?.[0];
---
<a href={`/work/${p.slug}/`} class="card">
  <div class="image">
    {lead
      ? <Shot src={lead.src} alt={lead.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 33vw" cover class="fill" />
      : <span class="todo slot">Image placeholder</span>}
  </div>
  <div class="label">
    <span class="eyebrow">{p.relation}</span>
    <span class="client">{p.client}</span>
  </div>
  <dl class="facts">
    <div><dt>Built</dt><dd><V v={p.built} /></dd></div>
    <div><dt>Live since</dt><dd class="metric"><V v={p.runningSince} /></dd></div>
    <div><dt>Result</dt><dd><V v={p.result} /></dd></div>
  </dl>
</a>

<style>
  .card { display: flex; flex-direction: column; border: 1px solid var(--line); background: var(--ink); color: var(--bone); }
  .card:hover { color: var(--bone); border-color: var(--line-strong); }
  .card:hover .client { color: var(--lime); }
  .image { position: relative; aspect-ratio: 16 / 10; border-bottom: 1px solid var(--line); overflow: hidden; }
  .image :global(.fill) { position: absolute; inset: 0; }
  .slot { position: absolute; top: 14px; right: 14px; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); padding: 2px 4px; }
  .label { padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; border-bottom: 1px solid var(--line); }
  .client { font-family: var(--serif); font-size: clamp(26px, 2.6vw, 34px); font-weight: 300; letter-spacing: -.02em; line-height: 1; }
  .facts { margin: 0; display: flex; flex-direction: column; }
  .facts > div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; align-items: baseline; padding: 10px 18px; border-bottom: 1px solid var(--line); }
  .facts > div:last-child { border-bottom: 0; }
  dt { font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); }
  dd { margin: 0; font-size: 14px; line-height: 1.4; }
</style>
