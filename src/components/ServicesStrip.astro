---
// The services index is a row of cells. Attention resolves one and lights it;
// the rest compress. Hover, focus or tap to open a cell.
import { services } from '../data/site';
---
<div class="strip" data-strip>
  {services.map((s, i) => (
    <button type="button" class:list={['cell', { on: i === 0 }]} aria-expanded={i === 0 ? 'true' : 'false'}>
      <span class="top"><span class="px"></span><span class="n metric">{s.n}</span></span>
      <span class="bottom">
        <span class="t">{s.t}</span>
        <span class="d">{s.d}</span>
        <span class="tags">{s.tags}</span>
      </span>
    </button>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
    const cells = [...strip.querySelectorAll<HTMLButtonElement>('.cell')];
    const open = (c: HTMLButtonElement) => cells.forEach((x) => {
      x.classList.toggle('on', x === c);
      x.setAttribute('aria-expanded', String(x === c));
    });
    cells.forEach((c) => {
      c.addEventListener('mouseenter', () => open(c));
      c.addEventListener('focus', () => open(c));
      c.addEventListener('click', () => open(c));
    });
  });
</script>

<style>
  .strip { display: flex; height: 320px; border: 1px solid var(--line); background: var(--ink); overflow: hidden; }
  .cell {
    all: unset; box-sizing: border-box;
    flex: 1; min-width: 0; border-right: 1px solid var(--line); padding: 18px;
    display: flex; flex-direction: column; justify-content: space-between;
    transition: flex .27s steps(3); cursor: default; color: var(--graphite);
  }
  .cell:last-child { border-right: 0; }
  .cell:focus-visible { outline: 1px solid var(--lime); outline-offset: -4px; }
  .cell.on { flex: 6; background: var(--panel); color: var(--bone); }
  .top { display: flex; align-items: center; gap: 10px; }
  .px { width: 7px; height: 7px; flex: none; background: transparent; }
  .on .px { background: var(--lime); }
  .n { font-size: 11px; }
  .bottom { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .t {
    font-family: var(--serif); font-size: 26px; font-weight: 300; letter-spacing: -.02em; line-height: 1.05;
    white-space: nowrap; writing-mode: vertical-rl; transform: rotate(180deg);
  }
  .on .t { writing-mode: horizontal-tb; transform: none; }
  .d, .tags { display: none; }
  .on .d { display: block; font-size: 14px; line-height: 1.55; max-width: 40ch; color: var(--muted); }
  .on .tags { display: block; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); }

  /* Narrow screens: the row becomes a column of halving cells */
  @media (max-width: 760px) {
    .strip { flex-direction: column; height: auto; }
    .cell { border-right: 0; border-bottom: 1px solid var(--line); flex: none; gap: 14px; transition: none; }
    .cell:last-child { border-bottom: 0; }
    .top { order: 0; }
    .t { writing-mode: horizontal-tb; transform: none; font-size: 22px; }
    .cell { flex-direction: row; align-items: baseline; justify-content: flex-start; }
    .cell.on { flex-direction: column; align-items: stretch; padding-bottom: 24px; }
    .on .t { font-size: 28px; }
  }
</style>
