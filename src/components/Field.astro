---
// A Live Field canvas. See src/scripts/field.ts for the data-* options.
interface Props {
  live?: boolean; root?: 'full' | 'h'; rows?: number; min?: number | string; k?: number | string;
  maxd?: number | string; fx?: number; fy?: number; fillall?: boolean; nolit?: boolean;
  class?: string; style?: string;
}
const { live, root = 'full', rows, min, k, maxd, fx, fy, fillall, nolit, class: cls = '', style } = Astro.props;
---
<canvas
  class:list={['qt', cls]}
  style={style}
  aria-hidden="true"
  data-live={live ? '' : undefined}
  data-root={root}
  data-rows={rows}
  data-min={min}
  data-k={k}
  data-maxd={maxd}
  data-fx={fx}
  data-fy={fy}
  data-fillall={fillall ? '' : undefined}
  data-nolit={nolit ? '' : undefined}
></canvas>
