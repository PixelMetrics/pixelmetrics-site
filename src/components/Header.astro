---
import Wordmark from './Wordmark.astro';
import { BOOK_URL } from '../data/site';
const path = Astro.url.pathname;
const onWork = path.startsWith('/work');
---
<header class="site-header">
  <div class="bar wrap-wide">
    <a href="/" class="home" aria-label="PixelMetrics home"><Wordmark size="24px" /></a>
    <nav aria-label="Main">
      <a href="/#services" class="nav-sm">Services</a>
      <a href="/#method" class="nav-sm">Method</a>
      <a href="/work/" aria-current={onWork ? 'page' : undefined}>Work</a>
      <a href={BOOK_URL} class="btn btn--sm">Book a scoping call</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding-top: 12px; padding-bottom: 12px;
  }
  .home { display: inline-flex; }
  .home:hover { color: var(--bone); }
  nav { display: flex; gap: 28px; font-size: 14px; align-items: center; }
  nav .btn { padding: 8px 14px; }
  nav a[aria-current='page'] { color: var(--lime); }
  @media (max-width: 680px) {
    .nav-sm { display: none; }
    nav { gap: 18px; }
  }
  @media (max-width: 420px) {
    nav .btn { padding: 9px 12px; font-size: 13px; }
  }
</style>
